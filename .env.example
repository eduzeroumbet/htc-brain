# ───────── domínio e infra ─────────
DOMAIN=brain.suaagencia.ae
TZ=Asia/Dubai

POSTGRES_USER=brain
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=brain

MINIO_ROOT_USER=brain
MINIO_ROOT_PASSWORD=troque-por-uma-senha-longa
S3_BUCKET_MEDIA=media
S3_BUCKET_DOCS=docs

CHATWOOT_SECRET_KEY_BASE=gere-com-openssl-rand-hex-64
# token do agente-bot criado no Chatwoot (Settings → Integrations → API)
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
# inbox onde os casos escalados aparecem
CHATWOOT_HUMAN_INBOX_ID=

LANGFUSE_NEXTAUTH_SECRET=gere-com-openssl-rand-hex-32
LANGFUSE_SALT=gere-com-openssl-rand-hex-32
# exatamente 64 hex
LANGFUSE_ENCRYPTION_KEY=gere-com-openssl-rand-hex-32
CLICKHOUSE_PASSWORD=troque-por-uma-senha-longa
# crie o projeto no Langfuse e cole aqui
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ───────── modelos ─────────
ANTHROPIC_API_KEY=sk-ant-...
# Chefe de Gabinete, QA
MODEL_STRATEGY=claude-opus-5
# consultores, conteúdo, mídia, reservas
MODEL_WORK=claude-sonnet-5
# triagem, roteamento, classificação
MODEL_FAST=claude-haiku-4-5-20251001
# teto diário de inferência para toda a máquina
DAILY_TOKEN_BUDGET_USD=60

# ───────── canais ─────────
# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=1337957899403844   # +971 58 515 3946 (WhatsApp Manager → Phone numbers)
WA_BUSINESS_ACCOUNT_ID=1032855926426525
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=um-segredo-para-o-webhook
WA_APP_SECRET=
# Messenger + Instagram (Meta)
META_PAGE_ID=1253783911161807
META_IG_ACCOUNT_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=outro-segredo-para-o-webhook
META_APP_SECRET=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=gere-com-openssl-rand-hex-16
# E-mail
IMAP_HOST=imap.suaagencia.ae
IMAP_USER=hello@suaagencia.ae
IMAP_PASSWORD=
SMTP_HOST=smtp.suaagencia.ae
SMTP_PORT=587
SMTP_USER=hello@suaagencia.ae
SMTP_PASSWORD=
SMTP_FROM="Sua Agência <hello@suaagencia.ae>"
# Webchat
WEBCHAT_SIGNING_SECRET=gere-com-openssl-rand-hex-32
# Brasil (+55) pausado no WhatsApp até o teste de entrega passar (erro 130497). Só um humano troca para true.
WA_BR_DELIVERY_ENABLED=false
# all = nenhuma mensagem WhatsApp para +55; proactive_only = só bloqueia template/follow-up
WA_BR_BLOCK_SCOPE=all
# Rota alternativa (config/alt_route.yaml): canal vazio não aparece na mensagem
ALT_ROUTE_WEBCHAT_URL=
ALT_ROUTE_EMAIL=
ALT_ROUTE_MESSENGER_URL=
ALT_ROUTE_INSTAGRAM_HANDLE=

# ───────── CEO e humanos que ficam ─────────
# recebe briefing 07:00, aprovações e emergências
CEO_WHATSAPP=+9715XXXXXXXX
CEO_EMAIL=ceo@suaagencia.ae
# login simples do dashboard (HTTP Basic); troque por SSO depois
DASHBOARD_PASSWORD=troque
# 2ª pessoa do plantão de suporte avançado (config/humans.yaml)
SENIOR_OPS_WHATSAPP=+9715XXXXXXXX
# funcionário de resolução presencial (programação enviada pela máquina)
RESOLVER_1_WHATSAPP=+9715XXXXXXXX
# plantão noturno de resolução (só critical)
RESOLVER_2_WHATSAPP=+9715XXXXXXXX

# ── Jev (TypeSafe AI) — decisões tipadas: triagem, risco de ferramenta, moderação, scores ──
# ou https://api.typesafe.ai/v1/systemone com a chave oficial
JEV_API_URL=https://jevtypesafeai.com/api/v1/decide
# jv_live_... — sem chave a máquina roda com fallback (Haiku + regras); nunca comitar
JEV_API_KEY=
# pinar em produção; jev-latest só em staging
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_S=3

# ── Redes sociais (publicação automática; sem token a peça sai como "pacote manual") ──
# Meta Graph (Instagram Business + Página) — long-lived token de sistema
IG_HIGHCLASS_TOKEN=
FB_HIGHCLASS_TOKEN=
# bot admin do canal Telegram em russo (publica no canal)
TG_HIGHCLASS_RU_BOT_TOKEN=
# token de comunidade VK (wall.post)
VK_HIGHCLASS_TOKEN=

# ── Jurídico / Infra ──
# screening de sanções (OFAC/EU/UK/UN); sem chave, screening manual com decisão da CEO
OPENSANCTIONS_API_KEY=
# onde scripts/backup.sh grava os .enc (SysOps mede a idade)
BACKUP_DIR=backups
# JSON {"WA_ACCESS_TOKEN":"2026-10-01",...} — SysOps avisa ≥ 90 dias
SECRETS_ROTATED_AT={}

# ── Dubai Explore (página Facebook 61594438771399 — topo de funil / validação de anúncios) ──
FB_DUBAIEXPLORE_TOKEN=                 # Page access token (longa duração) via System User do Business Portfolio
IG_DUBAIEXPLORE_TOKEN=                 # se houver Instagram profissional ligado à página
META_PIXEL_ID=                         # pixel/Conversions API para medir leads do WhatsApp/landing

# ── Áudio do cliente (WhatsApp) → texto. Uma das duas chaves; Groq é mais rápida e barata
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Huda — consultora WhatsApp já em operação (Manus WebDev + Evolution API). Ela POSTa leads/handoffs em /webhooks/huda
HUDA_WEBHOOK_SECRET=                   # mesmo valor configurado no cofre do WebDev (header X-Huda-Token); gere com: openssl rand -hex 24

